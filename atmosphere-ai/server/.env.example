# ==========================================
# Atmosphere AI Server Environment Variables
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed Origins for CORS (comma-separated or single URL)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection String
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/atmosphere_ai?retryWrites=true&w=majority
# Example for Local: mongodb://localhost:27017/atmosphere_ai
MONGODB_URI=mongodb://localhost:27017/atmosphere_ai

# JSON Web Token (JWT) Configuration
JWT_SECRET=super_secret_atmosphere_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# AI Assistant Integrations
OPENAI_API_KEY=
GEMINI_API_KEY=

# Meteorological Weather Data Provider Configuration
# Supported options: 'real' (default, powered by Open-Meteo live API), 'mock', 'openweathermap', 'weathergov'
WEATHER_PROVIDER=real

# External Weather Provider API Credentials (Stored exclusively on server)
# OpenWeatherMap API Key (Optional)
OPENWEATHER_API_KEY=

# Open-Meteo API Key (Optional for high volume / commercial usage)
OPENMETEO_API_KEY=
