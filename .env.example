# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/atmosphere_ai?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI Assistant Configuration
OPENAI_API_KEY=your-openai-api-key-optional
GEMINI_API_KEY_SERVER=your-gemini-api-key-optional

# Weather Provider Integration
# WEATHER_PROVIDER: 'real' (default, uses Open-Meteo live API), 'mock', 'openweathermap', or 'weathergov'
WEATHER_PROVIDER=real
# OPENWEATHER_API_KEY: Optional API key for OpenWeatherMap integration
OPENWEATHER_API_KEY=
# OPENMETEO_API_KEY: Optional commercial key for Open-Meteo
OPENMETEO_API_KEY=

# Client Environment Variables (Vite)
VITE_API_BASE_URL=/api
VITE_APP_NAME="Atmosphere AI"
VITE_MAP_PROVIDER=leaflet
VITE_STADIA_MAPS_API_KEY=c1610257-cddf-45cb-9a3a-dc91d8603559
